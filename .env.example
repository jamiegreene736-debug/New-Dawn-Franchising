# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Admin credentials ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-password

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-long-random-string

# ─── AI / Content ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ElevenLabs homepage overview voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Lead Enrichment ─────────────────────────────────────────────────────────
# Contact search runs as layered providers: Seamless.AI (primary) + Apollo.io and
# Origami as supplemental layers. Results are merged and de-duplicated. Each
# provider is optional — add only the keys you have; the UI lets you pick which
# sources to search and shows remaining credits per provider where reported.

# Seamless.AI — primary contact search + enrichment provider.
# Create a key at: Seamless app → Settings → Public API → Create New Connection.
SEAMLESS_API_KEY=
# Seamless org-contact AUTO-SYNC (server/seamless-org-sync.ts). When SEAMLESS_API_KEY
# is set, the contacts saved in your Seamless account ("My Contacts") are pulled via
# GET /contacts on a schedule and upserted into the main CRM tab (crm_clients) with
# full enrichment — you then assign them to lists from the CRM tab. The Seamless
# public API has no per-"Contact List" filter and no webhooks, so this syncs ALL org
# contacts by polling (not a per-list, instant push). All optional (defaults shown):
# SEAMLESS_SYNC_CRON=*/5 * * * *        # how often to poll (node-cron)
# SEAMLESS_SYNC_BACKFILL_DAYS=730       # first-run lookback (walked in <=29-day windows)
# SEAMLESS_SYNC_MAX_PAGES=50            # safety cap (×100 contacts per window)

# Apollo.io — supplemental people/company search + CRM org-contact sync.
# Create a key at: Apollo → Settings → Integrations → API.
# People Search requires a MASTER API key. The Contacts API (/contacts/search,
# /labels — used by the org sync) additionally requires a PAID Apollo plan:
# on a free plan those endpoints return 403 no matter what key you use.
APOLLO_API_KEY=
# Apollo org-contact AUTO-SYNC (server/apollo-org-sync.ts). When APOLLO_API_KEY is set,
# saved Apollo contacts are pulled via POST /contacts/search and upserted into crm_clients.
# Apollo lists ("labels") are mirrored as CRM lists named "Apollo · {list name}" so they
# appear in the Campaigns audience picker. On a Contacts-API 403 the cron pauses itself
# for 24h (manual POST /api/apollo/sync retries immediately). Optional tuning:
# APOLLO_ORG_SYNC_ENABLED=true        # false/0/off = never schedule the cron
# APOLLO_SYNC_CRON=*/15 * * * *       # how often to poll (node-cron)
# APOLLO_SYNC_MAX_PAGES=100             # safety cap (×100 contacts per page)

# Origami (origami.chat) — supplemental contact search.
# ORIGAMI_API_KEY is required to enable it. The base URL and paths are
# overridable in case your Origami account uses a different host/route.
ORIGAMI_API_KEY=
# ORIGAMI_API_BASE=https://api.origami.chat
# ORIGAMI_SEARCH_PATH=/v1/contacts/search
# ORIGAMI_CREDITS_PATH=/v1/account/credits

HUNTER_API_KEY=
PROXYCURL_API_KEY=
ZEROBOUNCE_API_KEY=
SERPAPI_KEY=
PEOPLE_DATA_LABS_API_KEY=
WHITEPAGES_API_KEY=
APIFY_API_TOKEN=

# ─── Outreach / Messaging ────────────────────────────────────────────────────
# SMS — Quo (OpenPhone)
QUO_API_KEY=
QUO_PHONE_NUMBER_ID=

# WhatsApp — Meta Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (for template management / reference)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any string you choose; must match the Verify Token set in the Meta webhook config
META_WHATSAPP_VERIFY_TOKEN=

# Ringless voicemail — Drop Cowboy
DROPCOWBOY_TOKEN=

# Email (Gmail App Password — 16-char app password per mailbox; account needs 2FA on)
GMAIL_APP_PASSWORD=
GMAIL_APP_PASSWORD_DYLAN=
# Primary CRM sending identity + two-way inbox sync (franchising@newdawnfranchising.com)
GMAIL_APP_PASSWORD_FRANCHISING=
GMAIL_APP_PASSWORD_INFO=
GMAIL_APP_PASSWORD_SUPPORT=

# ─── Campaign email throttle (deliverability / anti-spam) ─────────────────────
# Drip-campaign emails are spaced out to avoid bulk-sender spam flags:
#   • only sent Mon–Fri 8 AM–5 PM CT,
#   • 5–18s organic jitter between every send,
#   • paced per recipient domain, and
#   • capped per hour AND per day (counts are DB-backed, so they survive
#     restarts/redeploys). All three knobs below are optional overrides.
# EMAIL_DAILY_CAP defaults to 100 × the number of sender mailboxes with an app
# password configured (sender rotation spreads the volume across them), so add
# GMAIL_APP_PASSWORD_* secrets to scale capacity before raising this by hand.
EMAIL_DAILY_CAP=400
EMAIL_HOURLY_CAP=50
EMAIL_DOMAIN_GAP_SECONDS=45

# How many high-fit introducers the daily auto-campaign aims to enroll.
# Default 25 (quality over a 100+/day blast).
DAILY_CAMPAIGN_TARGET_CONTACTS=25

# Re-enable the 8AM AI Agent + broker/partner sequence crons (off by default —
# daily Outreach Intelligence owns automated sending).
# PARALLEL_OUTREACH=true

# Max LinkedIn connect/DM tasks created per ET day from the drip processor.
LINKEDIN_DAILY_QUEUE_CAP=25

# ─── Marketing / Analytics ───────────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Direct mail ─────────────────────────────────────────────────────────────
LOB_API_KEY=
LOB_TEMPLATE_ID=
LOB_WEBHOOK_SECRET=

# ─── Calendly ────────────────────────────────────────────────────────────────
CALENDLY_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── App URL (used for email links, agent approval URLs, etc.) ───────────────
APP_BASE_URL=https://yourdomain.up.railway.app
